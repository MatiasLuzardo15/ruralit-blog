    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      // Phase 1 — entrance into controlled disorder (0.15s → ~1.0s)
      tl.fromTo("#c1", { opacity: 0, x:  546, y: -197, rotation: -18 }, { opacity: 1, x:  580, y: -175, rotation: -13, duration: 0.7, ease: "power3.out" }, 0.15);
      tl.fromTo("#c2", { opacity: 0, x: -274, y:  177, rotation:  15 }, { opacity: 1, x: -300, y:  205, rotation:  10, duration: 0.7, ease: "power3.out" }, 0.23);
      tl.fromTo("#c3", { opacity: 0, x: -404, y:  116, rotation: -12 }, { opacity: 1, x: -380, y:   90, rotation:  -7, duration: 0.7, ease: "power3.out" }, 0.31);
      tl.fromTo("#c4", { opacity: 0, x:  670, y: -253, rotation:  17 }, { opacity: 1, x:  640, y: -285, rotation:  12, duration: 0.7, ease: "power3.out" }, 0.39);
      tl.fromTo("#c5", { opacity: 0, x: -448, y: -254, rotation: -16 }, { opacity: 1, x: -420, y: -230, rotation: -11, duration: 0.7, ease: "power3.out" }, 0.47);
      tl.fromTo("#c6", { opacity: 0, x: -526, y:   65, rotation:  13 }, { opacity: 1, x: -560, y:   95, rotation:   8, duration: 0.7, ease: "power3.out" }, 0.55);

      // Phase 2 — disorder intensifies (2.6s → ~4.0s): jitter + overlap
      tl.to("#c1", { x:  600, y: -159, rotation: -11, duration: 0.9, ease: "sine.inOut" }, 2.60);
      tl.to("#c2", { x: -318, y:  191, rotation:   8, duration: 0.9, ease: "sine.inOut" }, 2.67);
      tl.to("#c3", { x: -364, y:   72, rotation:  -4, duration: 0.9, ease: "sine.inOut" }, 2.74);
      tl.to("#c4", { x:  618, y: -265, rotation:  10, duration: 0.9, ease: "sine.inOut" }, 2.81);
      tl.to("#c5", { x: -400, y: -246, rotation:  -9, duration: 0.9, ease: "sine.inOut" }, 2.88);
      tl.to("#c6", { x: -580, y:  113, rotation:   5, duration: 0.9, ease: "sine.inOut" }, 2.95);

      // "Loss" beat — card 6 sinks into the cluster and dims (a record feels lost among the notes)
      tl.to("#c6", { y: 200, opacity: 0.4, duration: 0.75, ease: "power2.in" }, 3.9);

      // Handwritten marks appear during disorder
      tl.fromTo("#mark-q", { opacity: 0, scale: 0.7, rotation: -12 }, { opacity: 1, scale: 1, rotation: -6, duration: 0.5, ease: "back.out(1.6)" }, 1.15);
      tl.fromTo("#mark-mal", { opacity: 0, x: -14, rotation: -8 }, { opacity: 1, x: 0, rotation: -3, duration: 0.5, ease: "back.out(1.5)" }, 1.4);

      // Strike-through correction lines draw during disorder
      tl.fromTo("#strike2 line", { strokeDashoffset: 340, opacity: 0 }, { strokeDashoffset: 0, opacity: 1, duration: 0.5, ease: "power2.inOut" }, 3.05);
      tl.fromTo("#strike5 line", { strokeDashoffset: 340, opacity: 0 }, { strokeDashoffset: 0, opacity: 1, duration: 0.5, ease: "power2.inOut" }, 3.3);

      // Alert dot pops on card 3 (flagged uncertainty) + gentle finite pulse
      tl.fromTo("#alert-dot", { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(1.8)" }, 3.35);
      tl.to("#alert-dot", { scale: 1.28, duration: 0.5, ease: "sine.inOut", yoyo: true, repeat: 3 }, 3.85);

      // Duplicate record slides in and overlaps (the duplication problem)
      tl.fromTo("#dup", { opacity: 0, x: 320, y: -22, rotation: 6 }, { opacity: 1, x: 0, y: 0, rotation: 4, duration: 0.6, ease: "power2.out" }, 3.0);

      // Phase 3 — organization (5.1s → ~7.0s): chaos → clean alignment
      tl.to("#c1", { x: 0, y: 0, rotation: 0, duration: 1.15, ease: "expo.out" }, 5.10);
      tl.to("#c2", { x: 0, y: 0, rotation: 0, duration: 1.15, ease: "expo.out" }, 5.19);
      tl.to("#c3", { x: 0, y: 0, rotation: 0, duration: 1.15, ease: "expo.out" }, 5.28);
      tl.to("#c4", { x: 0, y: 0, rotation: 0, duration: 1.15, ease: "expo.out" }, 5.37);
      tl.to("#c5", { x: 0, y: 0, rotation: 0, duration: 1.15, ease: "expo.out" }, 5.46);
      tl.to("#c6", { x: 0, y: 0, rotation: 0, opacity: 1, duration: 1.15, ease: "expo.out" }, 5.55);

      // Corrections / uncertainty fade out as order arrives
      tl.to("#mark-q", { opacity: 0, scale: 0.85, duration: 0.45, ease: "power2.in" }, 5.35);
      tl.to("#mark-mal", { opacity: 0, x: -8, duration: 0.45, ease: "power2.in" }, 5.5);
      tl.to("#strike2 line", { opacity: 0, duration: 0.45, ease: "power2.in" }, 5.6);
      tl.to("#strike5 line", { opacity: 0, duration: 0.45, ease: "power2.in" }, 5.75);
      tl.to("#alert-dot", { opacity: 0, scale: 0.6, duration: 0.45, ease: "power2.in" }, 5.9);

      // Duplicate is removed / merged as order arrives
      tl.to("#dup", { opacity: 0, x: 520, y: 44, rotation: 9, duration: 0.7, ease: "power2.in" }, 5.2);

      // Structure emerges — header, group labels, guide rules
      tl.fromTo("#header", { opacity: 0, y: -16 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 5.9);
      tl.fromTo("#header-rule", { scaleX: 0 }, { scaleX: 1, duration: 0.8, ease: "expo.out" }, 6.1);
      tl.fromTo("#g1", { opacity: 0, x: -14 }, { opacity: 1, x: 0, duration: 0.6, ease: "power2.out" }, 6.05);
      tl.fromTo("#g2", { opacity: 0, x: -14 }, { opacity: 1, x: 0, duration: 0.6, ease: "power2.out" }, 6.22);
      tl.fromTo("#gr1", { scaleX: 0 }, { scaleX: 1, duration: 0.7, ease: "expo.out" }, 6.25);
      tl.fromTo("#gr2", { scaleX: 0 }, { scaleX: 1, duration: 0.7, ease: "expo.out" }, 6.4);

      // Phase 4 — clean payoff (8.0s): "ordenado" clarity mark + gentle breath
      tl.fromTo("#payoff", { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(1.4)" }, 8.0);
      tl.to("#payoff", { scale: 1.06, duration: 0.65, ease: "sine.inOut", yoyo: true, repeat: 1 }, 8.6);

      // Ambient breath on the notebook margin rule (gentle, finite, full 10s)
      tl.to(".margin-rule", { opacity: 0.55, duration: 1.5, ease: "sine.inOut", yoyo: true, repeat: 5 }, 0.4);

      window.__timelines["el-problema"] = tl;

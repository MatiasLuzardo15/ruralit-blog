    <style>
      @font-face {
        font-family: "Hanken Grotesk";
        font-style: normal;
        font-weight: 400 800;
        font-display: block;
        src: url(capture/assets/fonts/HankenGrotesk-Latin.woff2) format("woff2");
      }
      @font-face {
        font-family: "Caveat";
        font-style: normal;
        font-weight: 400 700;
        font-display: block;
        src: url(capture/assets/fonts/Caveat-Latin.woff2) format("woff2");
      }
      :root {
        --cream: #f8f1e5;
        --paper: #ffffff;
        --inner: #f0ebe3;
        --sand: #e9e1d5;
        --ink: #0e1e12;
        --graphite: #2a3a2f;
        --muted: #576246;
        --muted-bright: #6b7a5e;
        --line: rgba(14, 30, 18, 0.14);
        --line-soft: rgba(14, 30, 18, 0.08);
        --green: #2e9e53;
        --green-deep: #1a7a3a;
        --amber: #c78b2e;
        --amber-ink: #8a5c12;
        --alert: #c04a38;
        --alert-ink: #a83a28;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--cream);
        font-family: "Hanken Grotesk", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      #root {
        position: relative;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: var(--cream);
      }

      /* Notebook-paper texture: faint dot grid */
      .bg-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(14, 30, 18, 0.07) 1.4px, transparent 1.6px);
        background-size: 34px 34px;
        background-position: 0 0;
        z-index: 0;
        pointer-events: none;
      }

      /* Notebook margin rule (gentle ambient breath) */
      .margin-rule {
        position: absolute;
        left: 250px;
        top: 0;
        width: 2px;
        height: 100%;
        background: rgba(46, 158, 83, 0.18);
        z-index: 1;
        pointer-events: none;
      }

      .clip {
        position: absolute;
        inset: 0;
        z-index: 2;
      }

      /* Header (clean state) */
      .header {
        position: absolute;
        left: 338px;
        top: 148px;
        display: flex;
        align-items: center;
        gap: 14px;
        z-index: 6;
      }
      .header-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--green);
        display: block;
      }
      .header-kicker {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink);
      }
      .header-kicker .count {
        color: var(--muted);
        font-weight: 500;
        letter-spacing: 0.1em;
      }
      .header-rule {
        position: absolute;
        left: 600px;
        top: 163px;
        width: 980px;
        height: 2px;
        background: var(--line);
        transform-origin: left center;
        transform: scaleX(0);
        display: block;
        z-index: 5;
      }

      /* Group labels + rules (clean state) */
      .group-label {
        position: absolute;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        z-index: 6;
      }
      .group-label.g1 { left: 338px; top: 330px; color: var(--green-deep); }
      .group-label.g2 { left: 338px; top: 640px; color: var(--amber-ink); }
      .group-rule {
        position: absolute;
        top: 350px;
        left: 500px;
        width: 1080px;
        height: 2px;
        background: rgba(46, 158, 83, 0.32);
        transform-origin: left center;
        transform: scaleX(0);
        display: block;
        z-index: 5;
      }
      .group-rule.r2 { top: 660px; background: rgba(199, 139, 46, 0.34); }

      /* Record note-cards */
      .card {
        position: absolute;
        width: 380px;
        height: 172px;
        background: var(--paper);
        border: 1px solid var(--line-soft);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(14, 30, 18, 0.07);
        padding: 24px 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transform-origin: center center;
        z-index: 10;
        overflow: hidden;
      }
      .card .kicker {
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .card .kicker.green { color: var(--green-deep); }
      .card .kicker.amber { color: var(--amber-ink); }
      .card .value {
        font-size: 29px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.15;
        letter-spacing: -0.01em;
      }
      .card .meta {
        font-size: 16px;
        font-weight: 500;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.02em;
      }
      .card .meta .lote { color: var(--ink); font-weight: 700; }

      /* Handwritten marks (Caveat) — manual corrections / uncertainty */
      .mark {
        position: absolute;
        font-family: "Caveat", cursive;
        font-weight: 600;
        pointer-events: none;
        z-index: 12;
        line-height: 1;
      }
      .mark.question {
        right: 22px;
        top: 20px;
        font-size: 38px;
        color: var(--alert);
        transform: rotate(-6deg);
      }
      .mark.crossed {
        left: 28px;
        bottom: 18px;
        font-size: 32px;
        color: var(--alert);
        transform: rotate(-3deg);
      }

      /* Strike-through SVG (correction lines), drawn in disorder, fade in organize */
      .strike {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 11;
      }
      .strike line {
        stroke: var(--alert);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-dasharray: 340;
        stroke-dashoffset: 340;
      }

      /* Alert dot — loss / flagged uncertainty on a card */
      .alert-dot {
        position: absolute;
        right: 26px;
        bottom: 22px;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: var(--alert);
        box-shadow: 0 0 0 4px rgba(192, 74, 56, 0.16);
        z-index: 13;
        transform: scale(0);
        transform-origin: center;
      }

      /* Duplicate record card (the duplication problem) */
      .dup {
        position: absolute;
        left: 920px;
        top: 360px;
        width: 300px;
        height: 132px;
        background: var(--paper);
        border: 1px dashed rgba(192, 74, 56, 0.45);
        border-radius: 14px;
        box-shadow: 0 8px 22px rgba(14, 30, 18, 0.08);
        padding: 18px 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transform-origin: center center;
        z-index: 20;
      }
      .dup .dup-tag {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--alert-ink);
      }
      .dup .dup-val {
        font-size: 23px;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: -0.01em;
      }
      .dup .dup-meta {
        font-size: 14px;
        font-weight: 500;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }

      /* Green payoff — "ordenado" (clarity) */
      .payoff {
        position: absolute;
        left: 1360px;
        top: 942px;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 30;
        transform-origin: center center;
      }
      .payoff .check {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--green);
        display: grid;
        place-items: center;
        flex-shrink: 0;
      }
      .payoff .check svg { width: 19px; height: 19px; color: #fff; }
      .payoff .payoff-label {
        font-family: "Caveat", cursive;
        font-weight: 600;
        font-size: 30px;
        color: var(--green-deep);
        line-height: 1;
      }
    </style>
  </head>
